NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry — the Vercel Marketplace integration auto-provisions these in Preview/Production.
# Fill in locally only if you want to send errors from `next dev`.
# DSN is safe to expose (public key).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only; used for source-map upload. Scope: project:releases, org:read.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
